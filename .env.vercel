# ==========================================
# MRKOON AUDIT - Vercel Environment Variables
# ==========================================
#
# You can copy and paste the block for your target environment 
# directly into the Vercel Dashboard (Settings -> Environment Variables).

# ------------------------------------------
# PRODUCTION ENVIRONMENT
# ------------------------------------------
VITE_HOST_API=https://api.mrkoonapp.com/apiAdmin
VITE_MRKOON_WEBSITE=https://mrkoonapp.com
VITE_MRKOON_PORTAL=https://portal.mrkoonapp.com
VITE_ASSETS_DIR=

